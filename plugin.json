{
  "id": "neodex.carrefour",
  "name": "Carrefour",
  "version": "1.3.0",
  "author": "NDesumeur",
  "description": "Jeu de réflexe : règle les feux d'un carrefour où voitures, bus, tracteurs, vélos et ambulances prioritaires arrivent de tous les côtés. Un clic (ou une touche) passe un feu au vert ou au rouge. Évite l'accident et ne laisse personne attendre trop longtemps. Quatre carrefours à débloquer : croisement, passage à niveau avec son train, rond-point, étoile à six voies. Plein écran, record par carrefour. Un cinquième carrefour : deux carrefours reliés, où chaque feu compte pour l'autre.",
  "icon": "icon.png",
  "entry": "index.js",
  "view": "carrefour",
  "neobase": ">=4.0.0",
  "type": "app",
  "category": "Jeux",
  "compatibility": [
    "windows",
    "linux"
  ],
  "syncMode": "aucune",
  "syncInfo": "Rien n'est synchronisé : tes records restent sur cet appareil.",
  "mobile": false,
  "system": false,
  "dependencies": {},
  "sdk": "2.1.0",
  "permissions": [
    "storage"
  ],
